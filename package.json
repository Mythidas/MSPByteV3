{
  "name": "mspbytev3",
  "version": "0.0.1",
  "private": "true",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "backend/*"
  ],
  "scripts": {
    "build": "turbo build",
    "test": "turbo test",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "dev:web": "turbo dev --filter=@workspace/web",
    "dev:agent": "turbo dev --filter=@workspace/agents --filter=@workspace/agent",
    "dev:pipeline": "turbo dev --filter=@workspace/ingestor --filter=@workspace/workflows --filter=@workspace/compliance",
    "dev:workflows": "turbo dev --filter=@workspace/workflows",
    "infra:up": "cd backend && docker-compose up -d && docker-compose ps",
    "infra:down": "cd backend && docker-compose down",
    "infra:clean": "cd backend && docker-compose down -v",
    "supabase:types": "bunx supabase gen types typescript --project-id bhyazlrcyuvbporjyefx --schema public,views,vendors,definitions > packages/shared/src/types/schema.ts",
    "scripts:seeds": "turbo seeds --filter=@workspace/scripts",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "packageManager": "bun@1.1.26",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@types/minimatch": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "@workspace/ts-config": "workspace:*",
    "eslint": "^10.1.0",
    "prettier": "^3.8.1",
    "prettier-plugin-svelte": "^3.4.1",
    "tsc-alias": "^1.8.16",
    "typescript-eslint": "^8.58.0"
  },
  "dependencies": {
    "@supabase/postgrest-js": "^2.93.3",
    "@supabase/supabase-js": "^2.93.3",
    "turbo": "^2.8.1",
    "typescript": "5.7.3",
    "zod": "^4.3.6"
  }
}
